# -----------------------------------------------
# Frontend Configuration (Vite / Vercel)
# -----------------------------------------------
# Optional: Set this in Vercel to connect to your hosted backend server.
# If omitted or running locally, it defaults to the local server (/api proxy).
VITE_API_URL=http://localhost:5001

# -----------------------------------------------
# Backend Configuration (Node.js Express Server)
# -----------------------------------------------
PORT=5001
NODE_ENV=development

# Set this to your frontend URL in production to allow CORS requests:
FRONTEND_URL=http://localhost:5173
